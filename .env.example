# Django reads .env locally; deployment environment variables take precedence.
# Copy to .env only if you do not already have one. Fill credentials locally.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
PORT=8000
PUBLIC_ORIGIN=http://localhost:8000
# Production proxy must set X-Forwarded-Proto correctly before enabling this.
DJANGO_TRUST_PROXY=False
# Defaults: HTTPS redirect + secure cookies on in production, off with DEBUG=True.
# Override only for explicit local container testing without HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_COOKIES=True
DJANGO_HSTS_SECONDS=0
AMARA_DEMO_ENABLED=True
AMARA_EVIDENCE_WORKER=True
AMARA_MAX_AI_JOBS_PER_HOUR=60
# Optional exact domains, selected deliberately. Empty means no source-confirmed status.
AMARA_TRUSTED_SOURCE_DOMAINS=

# Supabase PostgreSQL connection string, not the REST project URL/anon key.
# Use the connection method supported by your deployment network, with SSL.
# Prefer the session pooler when the direct hostname is unreachable from this host.
DATABASE_URL=

# Mapbox public browser token: restrict it to the intended app URLs.
MAPBOX_PUBLIC_TOKEN=

# Server-side search credential.
TAVILY_API_KEY=

# Project endpoint provided by the user; NOT the inference base URL.
AZURE_AI_PROJECT_ENDPOINT=https://abdulmujeeb-7206-resource.services.ai.azure.com/api/projects/abdulmujeeb-7206

# Confirmed by Foundry's "Send a request" example.
AZURE_OPENAI_BASE_URL=https://abdulmujeeb-7206-resource.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra-1
AZURE_OPENAI_API_KEY=
